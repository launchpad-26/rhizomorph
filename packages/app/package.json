{
  "name": "@rhizomorph/app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The desktop shell: spawns the existing server, embeds the existing SPA, and adds nothing to either (prd-34 ruling 1)",
  "main": "dist/main.js",
  "scripts": {
    "build": "esbuild src/main/entry.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/main.js --external:electron",
    "start": "npm run build && electron dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rhizomorph/core": "*"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "esbuild": "0.28.1"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
