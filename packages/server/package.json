{
  "name": "@rhizomorph/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "rhizomorph": "./bin/rhizomorph.mjs"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/cli/index.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/cli/index.js --external:fastify",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rhizomorph/core": "*",
    "fastify": "5.10.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "tsx": "4.23.1"
  }
}
